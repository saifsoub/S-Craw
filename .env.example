# Copy this file to backend/.env before running locally
# Do NOT commit .env files with real secrets

PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collab_md
DB_USER=postgres
DB_PASSWORD=postgres

# JWT — must be long random strings in production (>= 32 chars)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret-32chars

# CORS origin (frontend dev server URL)
CORS_ORIGIN=http://localhost:5173
