# ── Supabase connection ────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → Database

# Direct connection (use for migrations, backend services)
DATABASE_URL=postgresql://postgres.[YOUR-DB-PASSWORD]@db.nrjfbqgvigankejaajrt.supabase.co:5432/postgres

# Connection pooler (recommended for serverless / high-concurrency)
# DATABASE_URL=postgresql://postgres.nrjfbqgvigankejaajrt:[YOUR-DB-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# ── Supabase JWT secret ────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Supabase public config (also needed in frontend/.env) ─────────────────────
